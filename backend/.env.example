# ── WebPro backend — biến môi trường (Railway: Variables) ─────────────

# Cổng chạy server (Railway tự cấp, local mặc định 5017)
# PORT=5017

# Domain thật của web, KHÔNG có "/" ở cuối — dùng cho canonical, sitemap, robots.txt
SITE_URL=https://webpro500.io.vn
# Origin được phép gọi API (CORS) — thường giống SITE_URL
FRONTEND_URL=https://webpro500.io.vn

# Thư mục chứa SQLite. Trên Railway phải gắn Volume vào /data, nếu không dữ liệu mất mỗi lần deploy.
DATA_DIR=/data

# Ký JWT cho trang admin — chuỗi ngẫu nhiên dài
JWT_SECRET=

# Upload ảnh trong admin
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email báo khách hàng mới (tuỳ chọn)
RESEND_API_KEY=
NOTIFY_EMAIL=

# Token xác thực webhook Ryze (POST /api/articles/webhook, header "Authorization: Bearer <token>").
# Điền cùng giá trị vào ô Bearer token trong Ryze. Tạo token 64 ký tự hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   hoặc: openssl rand -hex 32
RYZE_WEBHOOK_TOKEN=
